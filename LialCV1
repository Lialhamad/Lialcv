<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#f4f6fb;--surface:#ffffff;--surface2:#f0f3fa;--surface3:#e6ebf5;
  --accent:#4f6ef7;--accent2:#2d4fd6;--accent-light:#eef1fe;
  --text:#1a1d2e;--muted:#6b7294;--border:#dde2f0;--card:#ffffff;
  --teal:#0ea5b0;--teal-light:#e6f8f9;
  --purple:#7c3aed;--purple-light:#f3effe;
}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,sans-serif;min-height:100vh;overflow-x:hidden}
.shell{display:flex;min-height:100vh}

/* Sidebar */
.sidebar{width:230px;min-width:230px;background:var(--surface);border-right:1px solid var(--border);padding:2rem 1.1rem;display:flex;flex-direction:column;gap:.35rem;position:sticky;top:0;height:100vh}
.logo-wrap{margin-bottom:1.8rem;padding:.9rem 1rem;background:var(--accent-light);border-radius:12px;border:1px solid #d0d8fb}
.logo-name{font-size:1.05rem;font-weight:700;color:var(--accent2);letter-spacing:-.02em}
.logo-role{font-size:.72rem;color:var(--muted);margin-top:.15rem}
.nav-btn{display:flex;align-items:center;gap:.65rem;background:none;border:none;color:var(--muted);font-size:.83rem;padding:.6rem .8rem;border-radius:9px;cursor:pointer;width:100%;text-align:left;transition:all .18s}
.nav-btn i{font-size:1rem}
.nav-btn:hover{background:var(--surface2);color:var(--text)}
.nav-btn.active{background:var(--accent-light);color:var(--accent2);font-weight:600;border-left:3px solid var(--accent)}
.nav-btn .dot{width:5px;height:5px;border-radius:50%;background:var(--accent);margin-left:auto;opacity:0;transition:.2s}
.nav-btn.active .dot{opacity:1}
.sidebar-footer{margin-top:auto;padding-top:1rem;border-top:1px solid var(--border)}
.avail-badge{display:flex;align-items:center;gap:.5rem;font-size:.73rem;color:#059669;padding:.45rem .8rem;background:#ecfdf5;border-radius:8px;border:1px solid #a7f3d0;font-weight:500}

/* Main */
.main{flex:1;overflow-y:auto;padding:2.5rem 3rem}
.section{display:none;animation:fadeIn .28s ease}
.section.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

/* Hero */
.hero-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:2rem 2.2rem;margin-bottom:1.5rem;position:relative;overflow:hidden}
.hero-card::before{content:'';position:absolute;top:-40px;right:-40px;width:180px;height:180px;background:radial-gradient(circle,#dde4fd 0%,transparent 70%);pointer-events:none}
.hero-top{display:flex;align-items:center;gap:1.5rem;margin-bottom:1.2rem}
.avatar{width:68px;height:68px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--teal));display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:700;color:#fff;flex-shrink:0;letter-spacing:-.02em}
.hero h1{font-size:2rem;font-weight:700;letter-spacing:-.04em;color:var(--text)}
.hero-sub{font-size:.88rem;color:var(--muted);margin-top:.2rem;font-weight:500}
.hero-desc{font-size:.85rem;color:var(--muted);line-height:1.75;max-width:600px;margin-bottom:1.2rem}
.hero-chips{display:flex;flex-wrap:wrap;gap:.45rem;margin-bottom:1.2rem}
.chip{padding:.28rem .75rem;border-radius:999px;font-size:.73rem;font-weight:500}
.chip-accent{background:var(--accent-light);color:var(--accent2);border:1px solid #c5cefb}
.chip-teal{background:var(--teal-light);color:#0e7490;border:1px solid #a5f3fc}
.chip-purple{background:var(--purple-light);color:var(--purple);border:1px solid #ddd6fe}
.chip-gray{background:var(--surface2);color:var(--muted);border:1px solid var(--border)}
.contact-row{display:flex;flex-wrap:wrap;gap:.6rem}
.contact-pill{display:flex;align-items:center;gap:.4rem;background:var(--surface2);border:1px solid var(--border);border-radius:999px;padding:.32rem .9rem;font-size:.76rem;color:var(--muted);text-decoration:none;transition:.18s}
.contact-pill i{font-size:.85rem;color:var(--accent)}
.contact-pill:hover{background:var(--accent-light);color:var(--accent2);border-color:#c5cefb}

/* Stats */
.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:.9rem;margin-bottom:1.5rem}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.1rem 1rem;text-align:center}
.stat-num{font-size:1.7rem;font-weight:700;letter-spacing:-.04em}
.stat-num.blue{color:var(--accent)}
.stat-num.teal{color:var(--teal)}
.stat-num.purple{color:var(--purple)}
.stat-lbl{font-size:.72rem;color:var(--muted);margin-top:.2rem}

/* Section heading */
.sec-label{font-size:.68rem;letter-spacing:.12em;color:var(--accent);text-transform:uppercase;font-weight:600;margin-bottom:1.2rem;display:flex;align-items:center;gap:.5rem}
.sec-label::after{content:'';flex:1;height:1px;background:var(--border)}

/* Skills */
.skills-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(195px,1fr));gap:.9rem}
.skill-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1rem 1.1rem;transition:.18s}
.skill-card:hover{border-color:#c5cefb;background:var(--accent-light)}
.skill-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:.55rem}
.skill-name{font-size:.84rem;font-weight:600;color:var(--text)}
.skill-lvl{font-size:.68rem;color:var(--accent);font-weight:500;background:var(--accent-light);padding:.15rem .5rem;border-radius:999px}
.skill-bar-bg{height:3px;background:var(--surface3);border-radius:999px;overflow:hidden}
.skill-bar{height:100%;border-radius:999px;transition:width .9s cubic-bezier(.4,0,.2,1)}
.skill-tag{font-size:.68rem;color:var(--muted);margin-top:.45rem}

/* Category groups */
.cat-label{font-size:.72rem;font-weight:600;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;margin:1.5rem 0 .7rem;padding-left:.2rem}
.cat-label:first-child{margin-top:0}

/* Timeline */
.timeline{position:relative;padding-left:1.6rem}
.timeline::before{content:'';position:absolute;left:0;top:8px;bottom:8px;width:2px;background:var(--border);border-radius:2px}
.tl-item{position:relative;margin-bottom:2rem}
.tl-dot{position:absolute;left:-2.1rem;top:5px;width:11px;height:11px;border-radius:50%;background:var(--accent);border:2.5px solid var(--bg)}
.tl-company{font-size:.72rem;color:var(--muted);font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:.3rem}
.tl-header{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:.25rem}
.tl-role{font-weight:700;font-size:.92rem;color:var(--text)}
.tl-date{font-size:.72rem;color:var(--accent);white-space:nowrap;background:var(--accent-light);border:1px solid #c5cefb;padding:.2rem .6rem;border-radius:6px;font-weight:500}
.tl-bullets{margin-top:.4rem;padding-left:1rem}
.tl-bullets li{font-size:.8rem;color:var(--muted);line-height:1.65;margin-bottom:.2rem}
.tl-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.6rem}
.tl-tag{font-size:.68rem;background:var(--surface2);border:1px solid var(--border);padding:.16rem .52rem;border-radius:6px;color:var(--muted)}

/* Projects */
.proj-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem}
.proj-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.3rem;transition:.2s;cursor:default}
.proj-card:hover{border-color:#c5cefb;box-shadow:0 4px 20px rgba(79,110,247,.07)}
.proj-ico{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:.8rem;font-size:1.1rem}
.proj-ico.blue{background:var(--accent-light);color:var(--accent2)}
.proj-ico.teal{background:var(--teal-light);color:var(--teal)}
.proj-title{font-weight:700;font-size:.88rem;margin-bottom:.4rem;color:var(--text)}
.proj-org{font-size:.72rem;color:var(--accent);font-weight:500;margin-bottom:.4rem}
.proj-desc{font-size:.78rem;color:var(--muted);line-height:1.65}

/* Education & Certs */
.edu-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.1rem 1.4rem;margin-bottom:.8rem;display:flex;gap:1.2rem;align-items:flex-start}
.edu-ico{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
.edu-ico.purple{background:var(--purple-light);color:var(--purple)}
.edu-ico.blue{background:var(--accent-light);color:var(--accent2)}
.edu-ico.teal{background:var(--teal-light);color:var(--teal)}
.edu-title{font-weight:600;font-size:.88rem;color:var(--text)}
.edu-sub{font-size:.78rem;color:var(--accent);margin:.15rem 0 .2rem;font-weight:500}
.edu-date{font-size:.72rem;color:var(--muted)}
.edu-courses{font-size:.73rem;color:var(--muted);margin-top:.4rem;line-height:1.6}

/* Terminal */
.terminal{background:#f8f9ff;border:1px solid var(--border);border-radius:14px;overflow:hidden;font-family:'Courier New',monospace}
.term-bar{background:var(--surface);padding:.6rem 1rem;display:flex;align-items:center;gap:.5rem;border-bottom:1px solid var(--border)}
.term-dot{width:10px;height:10px;border-radius:50%}
.term-title{font-size:.73rem;color:var(--muted);margin-left:.5rem;font-family:'Segoe UI',sans-serif}
.term-body{padding:1.2rem;min-height:200px;max-height:300px;overflow-y:auto}
.term-line{font-size:.8rem;line-height:1.7;margin-bottom:.15rem}
.term-prompt{color:var(--accent2);font-weight:700}
.term-out{color:#047857}
.term-dim{color:#aab}
.term-input-row{display:flex;align-items:center;gap:.5rem;padding:.7rem 1.2rem;border-top:1px solid var(--border);background:var(--surface)}
.term-input-row span{color:var(--accent2);font-family:monospace;font-size:.82rem;font-weight:700}
.term-input{flex:1;background:none;border:none;outline:none;color:var(--text);font-family:'Courier New',monospace;font-size:.8rem}
.term-send{background:var(--accent);border:none;color:#fff;padding:.32rem .8rem;border-radius:7px;cursor:pointer;font-size:.75rem;font-family:'Segoe UI',sans-serif;transition:.15s;font-weight:500}
.term-send:hover{background:var(--accent2)}
</style>
</head>
