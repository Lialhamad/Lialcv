async function askAI(){
  const inp=document.getElementById('term-input');
  const q=inp.value.trim();
  if(!q)return;
  const body=document.getElementById('term-body');
  body.innerHTML+=`<div class="term-line"><span class="term-prompt">› </span>${q}</div>`;
  inp.value='';
  body.innerHTML+=`<div class="term-line term-dim" id="thinking">Processing...</div>`;
  body.scrollTop=body.scrollHeight;
  try{
    const r=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:1000,system:PROFILE,messages:[{role:'user',content:q}]})
    });
    const d=await r.json();
    const ans=d.content?.[0]?.text||'No response.';
    document.getElementById('thinking')?.remove();
    body.innerHTML+=`<div class="term-line term-out">${ans}</div><div class="term-line">&nbsp;</div>`;
  }catch(e){
    document.getElementById('thinking')?.remove();
    body.innerHTML+=`<div class="term-line" style="color:#dc2626">Error. Please try again.</div>`;
  }
  body.scrollTop=body.scrollHeight;
}
document.getElementById('term-input').addEventListener('keydown',e=>{if(e.key==='Enter')askAI()});
